{
  "name": "pwa-limpieza-casa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA para organizar las tareas de mantenimiento del hogar",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "test:integration": "vitest run tests/integration",
    "env:local": "supabase status -o env | grep -E '^(API_URL|ANON_KEY)=' | sed -E 's/^API_URL=/VITE_SUPABASE_URL=/; s/^ANON_KEY=/VITE_SUPABASE_ANON_KEY=/; s/=\"(.*)\"$/=\\1/' > .env"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^5.0.5"
  }
}
